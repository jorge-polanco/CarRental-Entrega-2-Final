    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarRentalServices\CarRentalServices.csproj" />
  </ItemGroup>

